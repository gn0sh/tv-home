<?xml version="1.0" encoding="utf-8"?>
<!-- mic-to-claude: qualifies the app for the digital assistant role. Assist only: no hotword, no keyguard launch,
     no local interaction, no settings activity. -->
<voice-interaction-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:sessionService="com.gnosh.tvhome.ClaudeSessionService"
    android:recognitionService="com.gnosh.tvhome.ClaudeRecognitionService"
    android:supportsAssist="true"
    android:supportsLaunchVoiceAssistFromKeyguard="false"
    android:supportsLocalInteraction="false" />
