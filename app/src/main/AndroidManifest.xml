<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- M1 permissions: nothing else. Never QUERY_ALL_PACKAGES. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- M2 tile row: see only apps with a TV launcher entry (package visibility). This is not a permission and grants
         nothing else; QUERY_ALL_PACKAGES stays out. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".TvHomeApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/banner"
        android:supportsRtl="true"
        android:theme="@style/Theme.TvHome">

        <activity
            android:name=".AgendaActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- M3, both OFF as installed (android:enabled="false"), so installing changes nothing about Home or the mic.
             scripts/tv-home-takeover.ps1, run by Brian himself, turns one on with `pm enable` and makes it the
             default, and its -Rollback undoes it. HomeEntry: the remote's Home button opens the dashboard. MicEntry:
             with Google Assistant switched off, the assist and voice keys open Ask Claude, listening. Neither has a
             permission guard: like any launcher, they only bring the dashboard or the Ask view to the front. -->
        <activity-alias
            android:name=".HomeEntry"
            android:targetActivity=".AgendaActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MicEntry"
            android:targetActivity=".AgendaActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <action android:name="android.intent.action.SEARCH_LONG_PRESS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Put a secret on the device over adb (architecture section 5). No intent-filter. Only holders of DUMP
             (the adb shell user; third-party apps cannot get it) may start it. -->
        <activity
            android:name=".ProvisionActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="" />

        <!-- Same guard. `adb shell content write` on content://com.gnosh.tvhome.provision/calendar_url streams the
             value over stdin so it is never a command-line argument (#10). -->
        <provider
            android:name=".ProvisionProvider"
            android:authorities="com.gnosh.tvhome.provision"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:grantUriPermissions="false" />
    </application>
</manifest>
