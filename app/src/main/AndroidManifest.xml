<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- M1 permissions: nothing else. Never QUERY_ALL_PACKAGES. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- M2 tile row: see only apps with a TV launcher entry (package visibility). This is not a permission and grants
         nothing else; QUERY_ALL_PACKAGES stays out. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".TvHomeApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/banner"
        android:supportsRtl="true"
        android:theme="@style/Theme.TvHome">

        <activity
            android:name=".AgendaActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- M3 Home: OFF as installed (android:enabled="false"), so installing changes nothing about Home.
             scripts/tv-home-takeover.ps1 -Home, run by Brian himself, turns it on with `pm enable` and makes it the
             default home; -Rollback restores the TV's own home. Like any launcher it only brings the dashboard to
             the front, so it has no permission guard. -->
        <activity-alias
            android:name=".HomeEntry"
            android:targetActivity=".AgendaActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- M3 mic: an accessibility service that only filters key events (res/xml/mic_key_filter.xml): it reads no
             screen content and handles no events. It consumes the remote's assist, voice and search keys and opens Ask
             Claude, listening; every other key passes untouched. It does nothing until enabled in the TV's
             accessibility settings, which scripts/tv-home-takeover.ps1 -Mic (run by Brian) does and -Rollback undoes.
             Google Assistant stays installed: it provides the speech recognition Ask Claude uses. -->
        <service
            android:name=".MicKeyService"
            android:exported="true"
            android:label="@string/mic_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/mic_key_filter" />
        </service>

        <!-- Put a secret on the device over adb (architecture section 5). No intent-filter. Only holders of DUMP
             (the adb shell user; third-party apps cannot get it) may start it. -->
        <activity
            android:name=".ProvisionActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="" />

        <!-- Same guard. `adb shell content write` on content://com.gnosh.tvhome.provision/calendar_url streams the
             value over stdin so it is never a command-line argument (#10). -->
        <provider
            android:name=".ProvisionProvider"
            android:authorities="com.gnosh.tvhome.provision"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:grantUriPermissions="false" />
    </application>
</manifest>
